Options -Indexes
RewriteEngine On

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 1. 301 Redirect: strip .php extension from browser URL
RewriteCond %{THE_REQUEST} \s/+(?:public/)?([^?]+)\.php(?:[?\s]|$) [NC]
RewriteCond %{REQUEST_URI} !^/(?:word/)?admin [NC]
RewriteCond %{REQUEST_URI} !^/(?:word/)?api [NC]
RewriteRule ^ %1 [R=301,L,NE]

# 2. Blog, Service, Case Study & Careers slug routing
RewriteRule ^blog/?$ blog/index.php [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9\-]+)/?$ blog/post.php?slug=$1 [L,QSA]
RewriteRule ^services/?$ services.php [L,QSA]
RewriteRule ^service/([a-zA-Z0-9\-]+)/?$ service-detail.php?slug=$1 [L,QSA]
RewriteRule ^services/([a-zA-Z0-9\-]+)/?$ service-detail.php?slug=$1 [L,QSA]
RewriteRule ^case-studies/?$ case-studies.php [L,QSA]
RewriteRule ^case-study/([a-zA-Z0-9\-]+)/?$ case-study-detail.php?slug=$1 [L,QSA]
RewriteRule ^careers/?$ careers.php [L,QSA]
RewriteRule ^career/([a-zA-Z0-9\-]+)/?$ job-detail.php?slug=$1 [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteRule ^who-we-are/?$ who-we-are.php [L,QSA]
RewriteRule ^404/?$ 404.php [L,QSA]

# 3. Clean extensionless URLs
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

# 4. Direct root slug fallback for blog articles
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(?:word/)?(?:admin|assets|img|uploads|public|api) [NC]
RewriteRule ^([a-zA-Z0-9\-]+)/?$ blog/post.php?slug=$1 [L,QSA]

# 5. Custom 404 Error Document
ErrorDocument 404 404.php
